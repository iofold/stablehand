      "name": "deepagents-cold-c1-glm",
      "harness": "langgraph",
      "agentPrefix": "perf-lifecycle-deepagents-cold-glm",
      "topology": "unique-agents",
      "sessionMode": "cold",
      "concurrency": 1,
      "iterations": 10,
      "sseClientsPerAgent": 2,
      "timeoutMs": 180000,
      "prompt": "Reply with exactly BENCHMARK_OK and nothing else.",
      "harnessConfig": {
        "provider": "openai",
        "model": "cf-glm-5.2-no-thinking",
        "maxTokens": 64,
        "reasoning": "off"
      }
    },
    {
