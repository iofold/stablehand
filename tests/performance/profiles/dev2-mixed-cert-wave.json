      "iterations": 2,
      "sseClientsPerAgent": 2,
      "settleMs": 3000,
      "timeoutMs": 420000,
      "expectedModelCallsPerTurn": 5,
      "prompt": "Run these three commands with separate bash tool calls: echo alpha, then echo beta, then echo gamma. Then reply with exactly BENCHMARK_OK and nothing else.",
      "harnessConfig": {
        "provider": "google",
        "model": "gemini-3.6-flash",
        "maxTokens": 2000,
        "thinkingLevel": "minimal"
      }
    },
    {
      "name": "tool-heavy-claude-c2",
      "harness": "claude-agents",
      "agentPrefix": "perf-cert-claude-tools",
      "topology": "unique-agents",
      "sessionMode": "cold",
      "concurrency": 2,
      "iterations": 2,
      "sseClientsPerAgent": 2,
      "settleMs": 3000,
      "timeoutMs": 420000,
      "expectedModelCallsPerTurn": 5,
      "prompt": "Run echo alpha, then echo beta, then echo gamma as three separate Bash tool calls. Then reply with exactly BENCHMARK_OK and nothing else.",
      "harnessConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-5"
      }
    },
    {
      "name": "mixed-sim-claude-c2",
      "harness": "claude-agents",
      "agentPrefix": "perf-cert-mix-claude",
      "topology": "unique-agents",
      "sessionMode": "cold",
      "concurrency": 2,
      "iterations": 2,
      "parallelGroup": "mixed-sim",
      "sseClientsPerAgent": 2,
      "settleMs": 3000,
      "timeoutMs": 300000,
      "prompt": "Reply with exactly BENCHMARK_OK and nothing else.",
      "harnessConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-5"
      }
    },
    {
