# Rendered to /etc/nginx/conf.d/default.conf when the container starts: the
# nginx image's entrypoint substitutes the two STABLEHAND_UI_ values, which
# 18-stablehand-upstream.envsh sets just before.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Look the API's address up per request, cached for 10 s, through the
    # container's own DNS server (127.0.0.11 under Docker Compose, the cluster
    # DNS under Kubernetes). A host written straight into proxy_pass is
    # resolved once at start, so recreating the orchestrator container (new
    # address) left /api answering 502 until this container restarted. The
    # variable is what makes nginx resolve at request time. proxy_pass with a
    # variable and no path forwards the client's request URI as sent.
    resolver ${STABLEHAND_UI_RESOLVER} valid=10s ipv6=off;
    set $stablehand_api ${STABLEHAND_UI_API_UPSTREAM};

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    # SSE stream endpoints (long-lived connections).
    # Covers the native agent stream and AG-UI runs; without the ag-ui arm those
    # runs fall into the buffered /api/ block and inherit its 60s read timeout.
    location ~ ^/api/(agents/[^/]+/stream|ag-ui/[^/]+/run)$ {
        proxy_pass http://$stablehand_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
        proxy_read_timeout 86400s;
    }

    # Regular API proxy (buffered)
    location /api/ {
        proxy_pass http://$stablehand_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
