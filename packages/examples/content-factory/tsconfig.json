{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "seed.ts",
    "apify-tools.ts",
    "notes-mcp/server.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
