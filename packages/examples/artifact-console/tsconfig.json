{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "../..",
    "outDir": "dist",
    "isolatedModules": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@ctxmill/client": ["../../client/src/index.ts"],
      "@ctxmill/react": ["../../react/src/index.ts"],
      "@ctxmill/shared": ["../../shared/src/index.ts"],
      "@/*": ["../../ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
