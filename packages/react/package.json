{
  "name": "@stablehand/react",
  "version": "0.1.0",
  "description": "React components and hooks for Stablehand AG-UI chat integrations",
  "license": "MIT",
  "author": "iofold",
  "homepage": "https://github.com/iofold/stablehand/tree/master/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iofold/stablehand.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/iofold/stablehand/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@stablehand/client": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
