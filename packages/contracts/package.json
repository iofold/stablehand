{
  "name": "@stablehand/contracts",
  "version": "0.1.0",
  "description": "Strict runtime contracts for Stablehand APIs and event streams",
  "license": "MIT",
  "author": "iofold",
  "homepage": "https://github.com/iofold/stablehand/tree/master/packages/contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iofold/stablehand.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/iofold/stablehand/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./budgets": {
      "types": "./dist/budgets.d.ts",
      "import": "./dist/budgets.js"
    },
    "./egress": {
      "types": "./dist/egress.d.ts",
      "import": "./dist/egress.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "import": "./dist/schedules.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    }
  },
  "files": [
    "dist",
    "test-fixtures"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
