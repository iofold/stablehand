{
  "name": "ctxmill",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework for building vertical AI products with ambient agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    }
  },
  "bin": {
    "ctxmill": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@anthropic-ai/claude-agent-sdk": "^0.2.76",
    "@ctxmill/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@langchain/anthropic": "^1.3.22",
    "@langchain/core": "^1.1.31",
    "@langchain/openai": "^1.2.12",
    "@mariozechner/pi-agent-core": "^0.58.1",
    "@mariozechner/pi-ai": "^0.58.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@openai/agents": "^0.7.1",
    "ai": "^6.0.116",
    "better-sqlite3": "^11.7.0",
    "deepagents": "^1.8.1",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "langchain": "^1.2.30",
    "mem0ai": "^2.3.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.8",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
