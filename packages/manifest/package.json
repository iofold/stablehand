{
  "name": "@stablehand/manifest",
  "version": "0.1.0",
  "description": "Strict browser-light and Node agent manifest contracts for Stablehand",
  "license": "MIT",
  "author": "iofold",
  "homepage": "https://github.com/iofold/stablehand/tree/master/packages/manifest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iofold/stablehand.git",
    "directory": "packages/manifest"
  },
  "bugs": {
    "url": "https://github.com/iofold/stablehand/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stablehand/contracts": "workspace:*",
    "tar-stream": "^3.1.8",
    "yaml": "^2.8.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
