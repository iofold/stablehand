{
  "name": "@stablehand/proto",
  "version": "0.1.0",
  "description": "Protocol Buffers and generated code for the Stablehand sandbox gRPC API",
  "license": "MIT",
  "author": "iofold",
  "homepage": "https://github.com/iofold/stablehand/tree/master/packages/proto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iofold/stablehand.git",
    "directory": "packages/proto"
  },
  "bugs": {
    "url": "https://github.com/iofold/stablehand/issues"
  },
  "type": "module",
  "exports": {
    "./sandbox/v1": {
      "types": "./gen/stablehand/sandbox/v1/sandbox_pb.ts",
      "default": "./dist/stablehand/sandbox/v1/sandbox_pb.js"
    }
  },
  "files": [
    "dist",
    "stablehand"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./sandbox/v1": {
        "types": "./dist/stablehand/sandbox/v1/sandbox_pb.d.ts",
        "default": "./dist/stablehand/sandbox/v1/sandbox_pb.js"
      }
    }
  },
  "scripts": {
    "build": "buf generate && tsc -p tsconfig.build.json",
    "build:js": "tsc -p tsconfig.build.json",
    "lint": "buf lint",
    "clean": "rm -rf gen dist"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.66.1",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "typescript": "^5.8.3"
  }
}
