{
  "name": "@ctxmill/sandbox-daemon",
  "version": "0.1.0",
  "type": "module",
  "description": "Sandbox daemon - gRPC server and harness adapters for ctxmill",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sandbox/proto-convert": {
      "import": "./dist/sandbox/proto-convert.js",
      "types": "./dist/sandbox/proto-convert.d.ts"
    },
    "./sandbox/checkpoint": {
      "import": "./dist/sandbox/checkpoint.js",
      "types": "./dist/sandbox/checkpoint.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.77",
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@ctxmill/proto": "workspace:*",
    "@ctxmill/shared": "workspace:*",
    "@langchain/anthropic": "^1.3.22",
    "@langchain/core": "^1.1.31",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/openai": "^1.2.12",
    "langsmith": "^0.5.15",
    "@mariozechner/pi-ai": "^0.58.1",
    "@mariozechner/pi-coding-agent": "^0.58.1",
    "deepagents": "^1.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
