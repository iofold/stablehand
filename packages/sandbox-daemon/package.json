{
  "name": "@ctxmill/sandbox-daemon",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Sandbox daemon - gRPC server and harness adapters for ctxmill",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sandbox/proto-convert": {
      "import": "./dist/sandbox/proto-convert.js",
      "types": "./dist/sandbox/proto-convert.d.ts"
    },
    "./sandbox/checkpoint": {
      "import": "./dist/sandbox/checkpoint.js",
      "types": "./dist/sandbox/checkpoint.d.ts"
    },
    "./harness/schemas": {
      "import": "./dist/harness/schemas.js",
      "types": "./dist/harness/schemas.d.ts"
    },
    "./harness/model-gateway": {
      "import": "./dist/harness/model-gateway.js",
      "types": "./dist/harness/model-gateway.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.195",
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@ctxmill/contracts": "workspace:*",
    "@ctxmill/proto": "workspace:*",
    "@ctxmill/shared": "workspace:*",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/langgraph-sdk": "^1.9.28",
    "@langchain/openai": "^1.5.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "deepagents": "^1.11.1",
    "langchain": "^1.5.4",
    "langsmith": "^0.7.17",
    "playwright": "1.58.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
