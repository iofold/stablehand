{
  "name": "@stablehand/client",
  "version": "0.1.0",
  "description": "Strict control-plane and AG-UI clients for Stablehand integrations",
  "license": "MIT",
  "author": "iofold",
  "homepage": "https://github.com/iofold/stablehand/tree/master/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iofold/stablehand.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/iofold/stablehand/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./control": {
      "types": "./dist/control-client.d.ts",
      "import": "./dist/control-client.js"
    },
    "./ag-ui": {
      "types": "./dist/ag-ui-client.d.ts",
      "import": "./dist/ag-ui-client.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@stablehand/contracts": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
