{
  "name": "@ctxmill/client",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed browser client for CTXMill AG-UI streaming integrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
