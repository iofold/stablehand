# Start here: install.sh fills in every blank secret below and keeps the ones
# you already set. To do it by hand, see "Install by hand" in README.md.

# ── Stack layout ─────────────────────────────────────────
# The default stack: the base services, the LiteLLM model gateway (prices every
# model call and enforces per-run spend caps) and the artifact gallery. Drop an
# overlay from the list to run without it, or set COMPOSE_FILE=docker-compose.yml
# for the base stack alone (model calls then go straight to the provider).
COMPOSE_FILE=docker-compose.yml:deploy/compose/model-gateway/docker-compose.yml:extensions/artifact-gallery/docker-compose.yml

# Prebuilt images: ghcr.io/iofold/stablehand-<name>:<tag>. `latest` follows
# master; pin a release (e.g. 0.1.0) or sha-<commit> for repeatable installs.
# install.sh writes the tag it pulled. `docker compose up --build` builds locally.
# STABLEHAND_IMAGE_TAG=latest
# STABLEHAND_IMAGE_REGISTRY=ghcr.io/iofold

# ── LLM Provider Keys ────────────────────────────────────
# Each harness resolves its own key from this list via the secrets pipeline.
# Set the keys for the providers your agents use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Model defaults ───────────────────────────────────────
# Default model for the learning pipeline reflector (OpenAI-compatible).
# Individual agents override this via their YAML manifest spec.model.id
OPENAI_MODEL=gpt-5.4-mini

# ── Cloudflare AI Gateway (optional) ────────────────────
# Uncomment to route all OpenAI-compatible calls through CF gateway.
# Models must use provider/ prefix (e.g. openai/gpt-5.4-mini)
# OPENAI_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/compat

# ── Model gateway (deploy/compose/model-gateway) ────────
# Required while the gateway overlay is in COMPOSE_FILE. Agents without an
# apiKeyRef in their manifest send model calls through it. LiteLLM keys must
# start with sk-. gateway-init registers the runtime key on first boot.
#   LITELLM_MASTER_KEY                    sk- + 48 hex chars (openssl rand -hex 24)
#   LITELLM_SALT_KEY, LITELLM_DATABASE_PASSWORD   openssl rand -hex 32
#   STABLEHAND_MODEL_GATEWAY_RUNTIME_KEY  sk- + 48 hex chars; this one enters sandboxes
#   ..._METERING_KEY, ..._ADMIN_KEY       stay in the orchestrator; a single-host
#                                         install can reuse the master key for both.
# The admin key turns on per-session keys, so a run stops at its spend cap.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_DATABASE_PASSWORD=
STABLEHAND_MODEL_GATEWAY_RUNTIME_KEY=
STABLEHAND_MODEL_GATEWAY_METERING_KEY=
STABLEHAND_MODEL_GATEWAY_ADMIN_KEY=
STABLEHAND_MODEL_GATEWAY_REVISION=local-1
# Comma-separated aliases whose zero cost is intentionally known to be free.
# STABLEHAND_MODEL_GATEWAY_EXPLICIT_FREE_MODELS=
# LITELLM_PORT=4400

# ── Artifact gallery (extensions/artifact-gallery) ──────
# The Overnight Analyst seed prints GALLERY_API_KEY (a scoped key, never the
# master token). The webhook secret is any random string: openssl rand -hex 24
GALLERY_API_KEY=
GALLERY_WEBHOOK_SECRET=
# GALLERY_PORT=8090

# ── Server ───────────────────────────────────────────────
# Defaults to http://localhost:${UI_PORT}. The UI reaches the API through its
# own nginx proxy, so this matters only for other browser origins.
# CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
# API_PORT=3002
# UI_PORT=3200
# POSTGRES_PORT=5433
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ── API authentication ───────────────────────────────────
# Operator master token. Required when NODE_ENV=production. Send as:
#   Authorization: Bearer <token>
# Create separate capability-scoped cmk_ keys for extensions in Settings.
STABLEHAND_API_TOKEN=
# Optional separate HMAC secret for sandbox ConnectRPC callbacks.
# Defaults to STABLEHAND_API_TOKEN when unset.
STABLEHAND_CALLBACK_TOKEN_SECRET=
# Local/testing escape hatch only. Do not enable in production.
STABLEHAND_AUTH_DISABLED=

# ── Outbound egress guard (SSRF protection) ──────────────
# Agent HTTP tools and webhook/callback delivery fetch agent-supplied URLs from
# the orchestrator. Destinations that resolve to private, loopback, link-local
# (incl. 169.254.169.254 metadata), or reserved ranges are blocked by default.
# Set to false only for local development.
# STABLEHAND_EGRESS_ENFORCE=true
# Comma-separated hosts allowed to bypass the block (reach internal services on
# purpose). Supports exact hosts, parent domains, and *.wildcard patterns.
# STABLEHAND_EGRESS_ALLOWLIST=hooks.internal.example.com,*.corp.example
# When true, ONLY allowlisted hosts are reachable (deny public by default).
# STABLEHAND_EGRESS_ALLOWLIST_ONLY=false
# Max redirects to follow while re-validating each hop (default 5).
# STABLEHAND_EGRESS_MAX_REDIRECTS=5
# Address people open Stablehand at. MCP OAuth sign-ins (e.g. Granola) redirect
# to <url>/api/mcp/oauth/callback. Unset: the browser's origin is used.
# STABLEHAND_PUBLIC_URL=https://stablehand.example.com

# ── Sandbox egress proxy ─────────────────────────────────
# Sandboxes reach package registries, GitHub and model APIs only
# (packages/egress-proxy/rules.default.txt). Agents widen or narrow that
# with their own `egress` setting (docs/sandbox-egress.md); the Overnight
# Analyst opens read-only web access for itself that way.
# Extra `;`-separated rules for every agent except those set to deny,
# e.g. "GET news.ycombinator.com/**" for one site:
STABLEHAND_EGRESS_EXTRA_ALLOW=
# Rules every agent keeps, including those set to deny:
STABLEHAND_EGRESS_RUNTIME_ALLOW=
# Requests that carry no session lease: "global" (server rules) until every
# sandbox started before per-agent egress is gone, then "deny".
STABLEHAND_EGRESS_UNLEASED=global


# ── Secrets encryption ───────────────────────────────────
# Master key for per-agent secret encryption (AES-256-GCM).
# Required when NODE_ENV=production. Generate with:
#   openssl rand -hex 32
SECRET_MASTER_KEY=

# ── S3 / MinIO (Artifact Storage) ────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=stablehand
S3_SECRET_KEY=stablehand-dev
S3_BUCKET=stablehand-artifacts
S3_REGION=us-east-1

# ── LangSmith Tracing (optional) ────────────────────────
# Set LANGSMITH_TRACING=true to enable agent tracing in LangSmith.
# LangGraph auto-traces; Claude and PI harnesses instrument conditionally.
# All vars are passed through to sandbox containers via the secret allowlist.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stablehand
# Required for service account keys (lsv2_sk_...). Not needed for personal keys (lsv2_pt_...).
LANGSMITH_WORKSPACE_ID=

# ── SigNoz / OpenTelemetry Tracing (local orchestrator + sandbox) ───
# docker-compose.yml preloads Node auto-instrumentation for the orchestrator,
# and sandbox images preload it through Bun. Base docker-compose defaults to no
# trace export. Use docker-compose.signoz.yml after starting local SigNoz to
# send traces through the stablehand static collector.
NODE_OPTIONS=--require @opentelemetry/auto-instrumentations-node/register
OTEL_SERVICE_NAME=stablehand-orchestrator
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=stablehand
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector-stablehand:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_NODE_RESOURCE_DETECTORS=env,host,os
OTEL_LOG_LEVEL=error

# Optional sandbox-specific overrides. When unset, dynamically spawned sandbox
# run containers inherit the OTEL exporter settings above, but use service names
# like stablehand-sandbox-langgraph and stablehand-sandbox-claude-agents.
# STABLEHAND_SANDBOX_OTEL_TRACES_EXPORTER=otlp
# STABLEHAND_SANDBOX_OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector-stablehand:4318
# STABLEHAND_SANDBOX_OTEL_SERVICE_NAME_PREFIX=stablehand-sandbox
