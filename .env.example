# ── LLM Provider Keys ────────────────────────────────────
# Each harness resolves its own key from this list via the secrets pipeline.
# Set the keys for the providers your agents use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Model defaults ───────────────────────────────────────
# Default model for the learning pipeline reflector (OpenAI-compatible).
# Individual agents override this via their YAML manifest spec.model.id
OPENAI_MODEL=gpt-5-mini

# ── Cloudflare AI Gateway (optional) ────────────────────
# Uncomment to route all OpenAI-compatible calls through CF gateway.
# Models must use provider/ prefix (e.g. openai/gpt-5-mini)
# OPENAI_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/compat

# ── Server ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
# API_PORT=3002
# UI_PORT=3200

# ── Secrets encryption ───────────────────────────────────
# Master key for per-agent secret encryption (AES-256-GCM).
# Change this in production!
# SECRET_MASTER_KEY=ctxmill-dev-key-change-in-prod

# ── S3 / MinIO (Artifact Storage) ────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ctxmill
S3_SECRET_KEY=ctxmill-dev
S3_BUCKET=ctxmill-artifacts
S3_REGION=us-east-1
