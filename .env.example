# ── LLM Provider Keys ────────────────────────────────────
# Each harness resolves its own key from this list via the secrets pipeline.
# Set the keys for the providers your agents use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Model defaults ───────────────────────────────────────
# Default model for the learning pipeline reflector (OpenAI-compatible).
# Individual agents override this via their YAML manifest spec.model.id
OPENAI_MODEL=gpt-5.4-mini

# ── Cloudflare AI Gateway (optional) ────────────────────
# Uncomment to route all OpenAI-compatible calls through CF gateway.
# Models must use provider/ prefix (e.g. openai/gpt-5.4-mini)
# OPENAI_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/compat

# ── Server ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
# API_PORT=3002
# UI_PORT=3200

# ── API authentication ───────────────────────────────────
# Required when NODE_ENV=production. Send as:
#   Authorization: Bearer <token>
CTXMILL_API_TOKEN=
# Optional separate HMAC secret for sandbox ConnectRPC callbacks.
# Defaults to CTXMILL_API_TOKEN when unset.
CTXMILL_CALLBACK_TOKEN_SECRET=
# Local/testing escape hatch only. Do not enable in production.
CTXMILL_AUTH_DISABLED=


# ── Secrets encryption ───────────────────────────────────
# Master key for per-agent secret encryption (AES-256-GCM).
# Required when NODE_ENV=production. Generate with:
#   openssl rand -hex 32
SECRET_MASTER_KEY=

# ── S3 / MinIO (Artifact Storage) ────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ctxmill
S3_SECRET_KEY=ctxmill-dev
S3_BUCKET=ctxmill-artifacts
S3_REGION=us-east-1

# ── LangSmith Tracing (optional) ────────────────────────
# Set LANGSMITH_TRACING=true to enable agent tracing in LangSmith.
# LangGraph auto-traces; Claude and PI harnesses instrument conditionally.
# All vars are passed through to sandbox containers via the secret allowlist.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ctxmill
# Required for service account keys (lsv2_sk_...). Not needed for personal keys (lsv2_pt_...).
LANGSMITH_WORKSPACE_ID=

# ── SigNoz / OpenTelemetry Tracing (local orchestrator + sandbox) ───
# docker-compose.yml preloads Node auto-instrumentation for the orchestrator,
# and sandbox images preload it through Bun. Base docker-compose defaults to no
# trace export. Use docker-compose.signoz.yml after starting local SigNoz to
# send traces through the ctxmill static collector.
NODE_OPTIONS=--require @opentelemetry/auto-instrumentations-node/register
OTEL_SERVICE_NAME=ctxmill-orchestrator
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=ctxmill
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector-ctxmill:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_NODE_RESOURCE_DETECTORS=env,host,os
OTEL_LOG_LEVEL=error

# Optional sandbox-specific overrides. When unset, dynamically spawned sandbox
# run containers inherit the OTEL exporter settings above, but use service names
# like ctxmill-sandbox-langgraph and ctxmill-sandbox-claude-agents.
# CTXMILL_SANDBOX_OTEL_TRACES_EXPORTER=otlp
# CTXMILL_SANDBOX_OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector-ctxmill:4318
# CTXMILL_SANDBOX_OTEL_SERVICE_NAME_PREFIX=ctxmill-sandbox
