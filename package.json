{
  "name": "stablehand-monorepo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up --build",
    "build": "pnpm -r build",
    "test": "pnpm test:backend && pnpm test:react",
    "lint": "eslint packages/ tests/",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts --project=chromium",
    "test:e2e:harness-matrix:slice1": "playwright test --config=playwright.harness-matrix.config.ts",
    "typecheck": "pnpm -r typecheck",
    "verify:fresh-deploy": "node scripts/verify-fresh-deploy.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v",
    "test:backend": "NODE_OPTIONS='--max-old-space-size=4096' timeout 600 vitest run",
    "test:ui": "pnpm -C packages/ui test",
    "test:react": "pnpm -C packages/react test",
    "verify:stabilization": "node scripts/verify-stabilization.mjs",
    "test:e2e:required": "playwright test --config=playwright.config.ts --project=chromium --grep @smoke",
    "test:e2e:harness-matrix:extended": "playwright test --config=playwright.harness-matrix.config.ts",
    "test:performance": "vitest run tests/performance/performance.test.ts packages/stablehand/src/observability/__tests__/performance.test.ts",
    "perf:dev2": "tests/performance/scripts/run-dev2.sh",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stablehand/manifest": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@sinclair/typebox": "^0.34.48",
    "eslint": "^10.0.3",
    "fast-check": "^4.6.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
