{
  "name": "ctxmill-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up --build",
    "build": "pnpm -r build",
    "test": "pnpm test:backend",
    "lint": "eslint packages/ tests/",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:e2e:harness-matrix:slice1": "playwright test --config=playwright.harness-matrix.config.ts",
    "typecheck": "pnpm -r typecheck",
    "verify:fresh-deploy": "node scripts/verify-fresh-deploy.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v",
    "test:backend": "NODE_OPTIONS='--max-old-space-size=4096' timeout 120 vitest run",
    "test:ui": "pnpm -C packages/ui test",
    "verify:stabilization": "node scripts/verify-stabilization.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@sinclair/typebox": "^0.34.48",
    "eslint": "^10.0.3",
    "fast-check": "^4.6.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
