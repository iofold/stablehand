{
  "name": "ctxmill-monorepo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up --build",
    "build": "pnpm -r build",
    "test": "pnpm test:backend",
    "lint": "eslint packages/ tests/",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts --project=chromium",
    "test:e2e:harness-matrix:slice1": "playwright test --config=playwright.harness-matrix.config.ts",
    "typecheck": "pnpm -r typecheck",
    "verify:fresh-deploy": "node scripts/verify-fresh-deploy.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v",
    "test:backend": "NODE_OPTIONS='--max-old-space-size=4096' timeout 240 vitest run",
    "test:ui": "pnpm -C packages/ui test",
    "verify:stabilization": "node scripts/verify-stabilization.mjs",
    "test:e2e:required": "playwright test --config=playwright.config.ts --project=chromium --grep @smoke",
    "test:e2e:harness-matrix:extended": "playwright test --config=playwright.harness-matrix.config.ts",
    "test:performance": "vitest run tests/performance/performance.test.ts packages/ctxmill/src/observability/__tests__/performance.test.ts",
    "perf:dev2": "tests/performance/scripts/run-dev2.sh",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ctxmill/manifest": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@sinclair/typebox": "^0.34.48",
    "eslint": "^10.0.3",
    "fast-check": "^4.6.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "esbuild"
    ],
    "overrides": {
      "protobufjs@<8": "7.6.5",
      "protobufjs@>=8": "8.7.0",
      "@protobufjs/utf8": ">=1.1.1",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": ">=1.14.4",
      "hono@<4.12.25": ">=4.12.25",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "undici@>=7 <7.28.0": ">=7.28.0",
      "ws@>=8 <8.21.0": ">=8.21.0",
      "fast-xml-parser@<5.7.0": ">=5.7.0",
      "fast-xml-builder@<=1.1.6": ">=1.1.7",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "path-to-regexp@>=8 <8.4.0": ">=8.4.0",
      "qs@<6.15.2": ">=6.15.2",
      "lodash@<4.18.0": ">=4.18.0",
      "basic-ftp@<5.3.1": ">=5.3.1",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4 <4.0.4": ">=4.0.4",
      "react-router@>=7 <7.15.1": ">=7.15.1 <8",
      "uuid@<11.1.1": "11.1.1",
      "uuid@>=13 <13.0.1": "13.0.2",
      "ip-address@<=10.1.0": ">=10.1.1",
      "js-yaml@<3.15.0": ">=3.15.0 <4",
      "@opentelemetry/core@<2.8.0": ">=2.8.0",
      "@anthropic-ai/sdk@>=0.79.0 <0.91.1": ">=0.91.1",
      "yaml@>=2 <2.8.3": ">=2.8.3",
      "shell-quote@<1.8.4": ">=1.8.4",
      "brace-expansion": "5.0.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jfgx-wxx8-mp94",
        "GHSA-7v5m-pr3q-6453",
        "GHSA-r95r-rj6r-c39x"
      ]
    }
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
