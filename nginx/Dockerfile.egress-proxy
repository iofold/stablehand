FROM nginx:1.27-alpine

# The nginx:alpine image ships with the stream module as a dynamic module.
# Load it explicitly in our config via the stream{} block — the module .so
# is already present at /etc/nginx/modules/ngx_stream_module.so.
# Some alpine builds package it separately; install just in case.
RUN apk add --no-cache nginx-mod-stream \
    && mkdir -p /var/log/nginx \
    && touch /etc/nginx/stream-map.conf

COPY allowed-domains.conf /etc/nginx/allowed-domains.conf
COPY egress-proxy.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 3128

ENTRYPOINT ["/entrypoint.sh"]
